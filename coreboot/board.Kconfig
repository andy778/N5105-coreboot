if BOARD_TECHVISION_TVI7309X

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select BOARD_ROMSIZE_KB_16384
	select CRB_TPM
	select DRIVERS_USB_ACPI
	select HAVE_ACPI_RESUME
	select HAVE_ACPI_TABLES
	select HAVE_INTEL_PTT
	select INTEL_GMA_HAVE_VBT
	select MAINBOARD_HAS_TPM2
	select SOC_INTEL_JASPERLAKE
	select SUPERIO_ITE_IT8613E

config MAINBOARD_DIR
	default "techvision/tvi7309x"

config MAINBOARD_PART_NUMBER
	default "TVI7309X"

config MAINBOARD_FAMILY
	string
	default "BKHD 1338NP-12"

config MAX_CPUS
	int
	default 4

config CBFS_SIZE
	default 0x800000

config DIMM_MAX
	default 2

config DIMM_SPD_SIZE
	default 512

config VGA_BIOS_ID
	string
	default "8086,4e61"

config INTEL_GMA_VBT_FILE
	default "src/mainboard/techvision/tvi7309x/data.vbt"

config FSP_TEMP_RAM_SIZE
	default 0x28000

endif # BOARD_TECHVISION_TVI7309X
