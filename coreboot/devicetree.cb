chip soc/intel/jasperlake

	device cpu_cluster 0 on end

	# Enhanced Intel SpeedStep
	register "eist_enable" = "1"

	# Enable C6 DRAM for deeper sleep
	register "enable_c6dram" = "1"

	# Thermal throttle offset from Tj_max (100C)
	register "tcc_offset" = "20"

	# GPE configuration
	# Map GPE0 DW0/DW1/DW2 to GPIO groups for wake events
	register "pmc_gpe0_dw0" = "GPP_G"
	register "pmc_gpe0_dw1" = "GPP_C"
	register "pmc_gpe0_dw2" = "GPP_R"

	# FSP configuration
	register "SaGv" = "SaGv_Enabled"
	register "SmbusEnable" = "1"

	# Display: Enable HDMI output (DDI port C from lspci VGA at 00:02.0)
	register "DdiPortCHpd" = "1"
	register "DdiPortCDdc" = "1"
	register "SkipExtGfxScan" = "1"

	# USB port configuration (sconfig does not allow C comments inside
	# multi-line register strings — keep these terse).
	# 0,1 = rear USB2; 2,3 = internal headers.
	register "usb2_ports" = "{
		[0] = USB2_PORT_SHORT(OC_SKIP),
		[1] = USB2_PORT_SHORT(OC_SKIP),
		[2] = USB2_PORT_SHORT(OC_SKIP),
		[3] = USB2_PORT_SHORT(OC_SKIP),
	}"

	# 0,1 = rear USB3.
	register "usb3_ports" = "{
		[0] = USB3_PORT_DEFAULT(OC_SKIP),
		[1] = USB3_PORT_DEFAULT(OC_SKIP),
	}"

	# SATA configuration (00:17.0 AHCI controller)
	register "SataSalpSupport" = "1"
	register "SataPortsEnable[0]" = "1"

	# LPC/eSPI decode ranges for ITE IT8613E Super I/O at 0x2e
	register "gen1_dec" = "0x003c0a01"	# 0xa00-0xa3f: IT8613E runtime regs
	register "gen2_dec" = "0x000c0081"	# 0x80-0x8f: debug port
	register "gen3_dec" = "0x00fc0201"	# 0x200-0x2ff: game port range

	# Skip CPU replacement check
	register "SkipCpuReplacementCheck" = "1"

	# HD Audio (00:1f.3) — disabled until hda_verb.c is provided

	# PCIe clock source mapping
	# Clk0 -> NVMe M.2 (RP1, 00:1c.0)
	# Clk1 -> I226-V LAN1 (RP5, 00:1c.4)
	# Clk2 -> I226-V LAN2 (RP6, 00:1c.5)
	# Clk3 -> I226-V LAN3 (RP7, 00:1c.6)
	# Clk4 -> I226-V LAN4 (RP8, 00:1c.7)
	register "PcieClkSrcUsage[0]" = "PCIE_CLK_FREE"
	register "PcieClkSrcUsage[1]" = "PCIE_CLK_FREE"
	register "PcieClkSrcUsage[2]" = "PCIE_CLK_FREE"
	register "PcieClkSrcUsage[3]" = "PCIE_CLK_FREE"
	register "PcieClkSrcUsage[4]" = "PCIE_CLK_FREE"
	register "PcieClkSrcUsage[5]" = "PCIE_CLK_NOTUSED"

	# Power management minimum assertion widths
	register "PchPmSlpS3MinAssert"  = "3"	# 50ms
	register "PchPmSlpS4MinAssert"  = "1"	# 1s
	register "PchPmSlpSusMinAssert" = "3"	# 1s
	register "PchPmSlpAMinAssert"   = "3"	# 98ms

	# xHCI LFPS sampling off time
	register "xhci_lfps_sampling_offtime_ms" = "9"

	register "disable_external_bypass_vr" = "true"

	# Power limits for N5105 (10W TDP)
	register "power_limits_config[JSL_N5105_10W_CORE]" = "{
		.tdp_pl1_override = 10,
		.tdp_pl2_override = 20,
	}"

	# ── PCI Device Tree ─────────────────────────────────────────────
	# Derived from lspci on BKHD 1338NP-12 / Techvision TVI7309X B0

	device domain 0 on
		device pci 00.0 on  end	# Host Bridge (8086:4e24)
		device pci 02.0 on  end	# UHD Graphics (8086:4e61)
		device pci 04.0 on  end	# Dynamic Tuning / Thermal
		device pci 05.0 off end	# IPU (not present on this board)
		device pci 08.0 off end	# GNA
		device pci 09.0 off end	# Intel Trace Hub
		device pci 12.0 off end	# Thermal Subsystem
		device pci 12.5 off end	# UFS
		device pci 12.6 off end	# GSPI 2
		device pci 14.0 on  end	# USB xHCI (8086:4ded)
		device pci 14.1 off end	# USB xDCI (OTG)
		device pci 14.2 on  end	# PMC SRAM
		device pci 14.3 off end	# CNVi WiFi (not present)
		device pci 14.5 off end	# SDCard
		device pci 15.0 off end	# I2C 0
		device pci 15.1 off end	# I2C 1
		device pci 15.2 off end	# I2C 2
		device pci 15.3 off end	# I2C 3
		device pci 16.0 on  end	# HECI / ME Interface (8086:4de0)
		device pci 16.1 off end	# HECI 2
		device pci 16.4 off end	# HECI 3
		device pci 16.5 off end	# HECI 4
		device pci 17.0 on  end	# SATA AHCI (8086:4dd3)
		device pci 19.0 off end	# I2C 4
		device pci 19.1 off end	# I2C 5
		device pci 19.2 off end	# UART 2
		device pci 1a.0 off end	# eMMC (not present)

		# PCIe Root Ports -- matched to lspci topology
		device pci 1c.0 on  end	# RP1 -> NVMe Samsung 980 (bus 01)
		device pci 1c.1 off end	# RP2 (not present)
		device pci 1c.2 off end	# RP3 (not present)
		device pci 1c.3 off end	# RP4 (not present)
		device pci 1c.4 on  end	# RP5 -> I226-V LAN1 (bus 02)
		device pci 1c.5 on  end	# RP6 -> I226-V LAN2 (bus 03)
		device pci 1c.6 on  end	# RP7 -> I226-V LAN3 (bus 04)
		device pci 1c.7 on  end	# RP8 -> I226-V LAN4 (bus 05)

		device pci 1e.0 off end	# UART 0
		device pci 1e.1 off end	# UART 1
		device pci 1e.2 off end	# GSPI 0
		device pci 1e.3 off end	# GSPI 1

		device pci 1f.0 on	# eSPI Controller (8086:4d87)
			chip superio/ite/it8613e
				device pnp 2e.0 off end
				device pnp 2e.1 on	# COM 1 (serial console)
					io 0x60 = 0x3f8
					irq 0x70 = 4
				end
				device pnp 2e.4 off end	# Environment Controller
				device pnp 2e.5 off end	# Keyboard
				device pnp 2e.6 off end	# Mouse
				device pnp 2e.7 on	# GPIO
					io 0x60 = 0xa10
					io 0x62 = 0xa00
				end
				device pnp 2e.a off end	# CIR
			end
		end
		device pci 1f.1 hidden end	# P2SB
		device pci 1f.2 hidden end	# Power Management Controller
		device pci 1f.3 off end		# HD Audio (8086:4dc8) — disabled
		device pci 1f.4 on  end		# SMBus (8086:4da3)
		device pci 1f.5 on  end		# SPI Controller (8086:4da4)
		device pci 1f.7 off end		# Intel Trace Hub

		# fTPM 2.0 (Intel PTT)
		chip drivers/crb
			device mmio 0xfed40000 on end
		end
	end
end
