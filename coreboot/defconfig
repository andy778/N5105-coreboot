# coreboot defconfig for Techvision TVI7309X (Jasper Lake N5105)
# Usage: copy to coreboot/.config or run `make defconfig KBUILD_DEFCONFIG=path/to/defconfig`

# Use the coreboot toolchain (not the host compiler)
# CONFIG_ANY_TOOLCHAIN is not set

# Payload: SeaBIOS (legacy BIOS boot; switch to edk2 if UEFI is needed)
CONFIG_PAYLOAD_SEABIOS=y
CONFIG_SEABIOS_STABLE=y

# Console output on COM1 via IT8613E Super I/O
CONFIG_CONSOLE_SERIAL=y
CONFIG_TTYS0_BASE=0x3f8
CONFIG_TTYS0_BAUD=115200

# Intel blobs
CONFIG_HAVE_IFD_BIN=y
CONFIG_HAVE_ME_BIN=y
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/techvision/tvi7309x/descriptor.bin"
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/techvision/tvi7309x/me.bin"

# Intel FSP: JSL FSP is not in the public IntelFsp/FSP repo; use the
# JasperLake FSP.fd from Dasharo's dasharo-blobs (fetched by
# setup_coreboot.sh, split into FSP-M/S at build time). Without
# ADD_FSP_BINARIES the ROM builds but will NOT boot.
CONFIG_ADD_FSP_BINARIES=y
CONFIG_FSP_FULL_FD=y
CONFIG_FSP_FD_PATH="3rdparty/blobs/mainboard/techvision/tvi7309x/Fsp.fd"

# TPM 2.0 (Intel PTT firmware TPM): CRB_TPM, MAINBOARD_HAS_TPM2 and
# HAVE_INTEL_PTT are promptless symbols selected by the board Kconfig —
# setting them here would be silently dropped by olddefconfig.

# Flash chip: Winbond W25Q128JVSIQ, 16 MB
CONFIG_COREBOOT_ROMSIZE_KB_16384=y

# Debug level (reduce for production)
CONFIG_DEFAULT_CONSOLE_LOGLEVEL=7
